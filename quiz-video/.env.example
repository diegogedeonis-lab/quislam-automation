ELEVENLABS_API_KEY=
# Voix : laisse ELEVENLABS_VOICE_ID vide pour la chercher par son nom
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_NAME=Léo
ELEVENLABS_MODEL=eleven_multilingual_v2
MUSIC_DIR=/assets/music
MUSIC_VOLUME=0.16
# Optionnel : Chromium du VPS (sinon Remotion télécharge le sien)
CHROME_PATH=
# 1 = voix muettes de test, sans appel API
VOICE_MOCK=0
